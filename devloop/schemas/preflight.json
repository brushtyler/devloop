{
  "type": "object",
  "additionalProperties": false,
  "required": ["ready", "gaps", "split", "trust_policy", "trust_policy_reason"],
  "properties": {
    "ready": {"type": "boolean"},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description", "code_refs", "proposed_default",
                     "repository_dependent"],
        "properties": {
          "kind": {"type": "string",
                   "enum": ["operator_decision", "default_available", "tool_unavailable"]},
          "description": {"type": "string"},
          "code_refs": {"type": "array", "items": {"type": "string"}},
          "proposed_default": {"type": "string"},
          "repository_dependent": {"type": "boolean"}
        }
      }
    },
    "split": {"type": "string"},
    "trust_policy": {"type": "string", "enum": ["none", "covered", "uncovered"]},
    "trust_policy_reason": {"type": "string"}
  }
}
