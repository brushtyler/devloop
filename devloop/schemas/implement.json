{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "pr_title", "commit_message", "pr_body", "acceptance_map",
               "host_step", "blocked_reason", "prerequisite", "blocked_by"],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "blocked"]},
    "summary": {"type": "string"},
    "pr_title": {"type": "string"},
    "commit_message": {"type": "string"},
    "pr_body": {"type": "string"},
    "acceptance_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "tests", "status", "reason"],
        "properties": {
          "criterion": {"type": "string"},
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "name"],
              "properties": {
                "file": {"type": "string"},
                "name": {"type": "string"}
              }
            }
          },
          "status": {"type": "string", "enum": ["covered", "not_covered"]},
          "reason": {"type": "string"}
        }
      }
    },
    "host_step": {"type": "string"},
    "blocked_reason": {"type": "string"},
    "prerequisite": {"type": "string"},
    "blocked_by": {"type": "integer"}
  }
}
