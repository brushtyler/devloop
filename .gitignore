# Local isolated CLI binaries & caches (populated by ./setup-ssdlc.sh --bootstrap)
.tools/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class

# Logs, secrets & temporary session archives
*.log
*.env
.env*
.sessions/

# devloop's state_dir (#563) and the local test durations of scripts/run-tests.py
.devloop/
# The state directory of the old SSDLC engine, that devloop neither reads nor writes: an old
# checkout keeps it out of git
.ssdlc/
