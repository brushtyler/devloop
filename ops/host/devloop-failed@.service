# Unità template dell'avviso di un servizio di devloop caduto (ops/host/devloop-failed@.service,
# #593): l'OnFailure= di devloop.service e di devloop@<progetto>.service. L'istanza è il progetto
# (_default senza PROJECT), come il file del progetto del comando devloop dell'host. Un processo
# morto non può avvisare: questa unità esegue, come root, il comando devloop dell'host
# (ops/host/devloop-command), che passa all'utente devloop del progetto, nel suo clone e con la
# sua copia fissata, `devloop notify --service-failed <progetto>`: il canale è [notify]
# dell'overlay del progetto, lo stesso avviso al più una volta per intervallo. Senza [notify]
# resta solo una riga nel journal di questa unità. Comune ai progetti dell'host: setup-devloop.sh
# la installa in SYSTEMD_DIR/devloop-failed@.service. Non si abilita: la avvia l'OnFailure=.
[Unit]
Description=devloop service failed, notice to the operator (%i)

[Service]
Type=oneshot
ExecStart=@DEVLOOP_COMMAND@ --project %i notify --service-failed %i
TimeoutStartSec=120
