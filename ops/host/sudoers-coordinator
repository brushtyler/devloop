# sudoers del coordinatore di devloop (ops/host/sudoers-coordinator), issue #530.
# setup-coordinator.sh lo installa in COORDINATOR_SUDOERS_FILE (mode 440) dopo averlo validato con
# visudo -c, sostituendo i segnaposto con i valori di params.env.
#
# Solo comandi di lettura (ADR 0002, precisazione del 2026-11-22), ciascuno con i suoi argomenti
# esatti, senza caratteri jolly. Come utente devloop: lo stato di devloop (devloop-pinned status),
# la direzione dell'operatore (devloop-pinned direction, #604) e le ultime righe di run.log, e la lettura di GitHub della sveglia del coordinatore (#543,
# ops/host/coordinator-wait.sh): devloop-pinned watch con i suoi intervalli e il suo file di
# stato, distinto da quello del supervisore, con la configurazione di devloop, senza che il
# coordinatore veda le chiavi del dispatcher. L'unica scrittura, e l'unico comando con argomenti
# liberi, è l'avviso all'operatore (devloop-pinned notify, #593, scelta N2 (a) dell'operatore):
# il testo dell'avviso, sul canale di [notify], con il token del bot che solo l'utente devloop
# legge e la deduplica di devloop. Come root: il journal e lo stato del servizio,
# senza pager, e check-host.sh --read-only dalla copia di root che setup-coordinator.sh installa
# in COORDINATOR_OPS_DIR, fuori dal clone di devloop. Nessun comando modifica l'host, avvia una
# CLI degli agent o apre una shell.

Defaults>@DEVLOOP_USER@ always_set_home, secure_path="@DEVLOOP_PATH@"

@COORDINATOR_USER@ ALL=(@DEVLOOP_USER@) NOPASSWD: \
    @LAUNCHER_CMD@ status, \
    @LAUNCHER_CMD@ direction, \
    @LAUNCHER_CMD@ notify *, \
    @LAUNCHER_CMD@ watch --until-change --interval 60 --timeout 300 --state @STATE_PATH@/coordinator-watch-state.json, \
    /usr/bin/tail -n 200 @STATE_PATH@/run.log, \
    /usr/bin/tail -n 1000 @STATE_PATH@/run.log

@COORDINATOR_USER@ ALL=(root) NOPASSWD: \
    /usr/bin/journalctl --no-pager -n 200 -u @SERVICE_NAME@, \
    /usr/bin/journalctl --no-pager -n 1000 -u @SERVICE_NAME@, \
    /usr/bin/systemctl status --no-pager @SERVICE_NAME@, \
    /usr/bin/bash @COORDINATOR_OPS_DIR@/host/check-host.sh --read-only
