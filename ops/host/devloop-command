#!/bin/bash
# Il comando devloop dell'host (ops/host/devloop-command, #588). setup-devloop.sh lo installa in
# DEVLOOP_COMMAND (default /usr/local/bin/devloop), 755 di root, sostituendo il segnaposto della
# directory dei progetti con DEVLOOP_PROJECTS_DIR; check-host.sh verifica che coincida.
#
# Esegue il launcher di un progetto come la sua unità systemd: come l'utente devloop del progetto
# (sudo -u … -H), nel suo clone, con il suo PATH e il suo LAUNCHER_CMD, quindi la copia fissata del
# servizio e lo --state-dir del progetto. Sottocomando e argomenti arrivano al launcher così come
# sono: devloop pin origin/main, devloop status, devloop follow issue-<N>. Gli unici sottocomandi
# di questo involucro, che ha solo l'opzione --project prima del sottocomando, sono pause e resume.
#
# pause e resume (#685; scelta R4 (a)): la pausa decisa dall'operatore, anche con issue e PR
# aperte. pause scrive, come root, la pausa COORDINATION_DIR/rest/pause ("<inizio> pausa", 644 di
# root: i ruoli, che scrivono in rest/, non la possono togliere né sostituire, per lo sticky bit),
# poi ferma il servizio (systemctl stop: devloop finisce il tick e le azioni in corso, senza
# avviarne altre). I ruoli entrano in pausa (ops/host/role-wait.sh), la sentinella li sveglia solo
# per un messaggio o un allarme, il watchdog dei ruoli li vede in pausa, e devloop run non parte
# finché la pausa c'è, anche se qualcuno avvia il servizio. resume toglie la pausa, poi riavvia il
# servizio: i ruoli in pausa si svegliano. Solo l'operatore li esegue: sono come root, e nessun
# ruolo ha una regola di sudo per questo comando.
#
# I progetti sono i file params-<progetto>.env della directory dei progetti (params-_default.env
# per l'installazione senza PROJECT), che setup-devloop.sh scrive da ops/host/devloop-command-project:
# questo script li legge riga per riga, non li esegue. Senza --project usa il solo progetto
# installato; con più progetti rifiuta e li elenca. Rimuovere il file di un progetto lo toglie dal
# comando.
#
# Va eseguito come root: un altro utente lo riesegue con sudo. Non sostituisce i sudoers di
# supervisore e coordinatore, che usano i comandi esatti del launcher.
set -euo pipefail

PROJECTS_DIR=@DEVLOOP_PROJECTS_DIR@

die() { printf 'devloop: %s\n' "$*" >&2; exit 2; }

usage() {
    cat <<'EOF'
Uso: devloop [--project NOME] <sottocomando> [argomenti...]

Esegue il launcher di devloop del progetto come la sua unità systemd (utente, clone, copia fissata,
state_dir), passandogli sottocomando e argomenti così come sono:

  devloop status
  devloop pin origin/main
  devloop --project widget follow issue-12

Due sottocomandi sono di questo comando (#685), solo per l'operatore:

  devloop [--project NOME] pause   la pausa: ferma il servizio e mette in pausa i ruoli
  devloop [--project NOME] resume  la ripresa: toglie la pausa e riavvia il servizio; i ruoli
                                   si svegliano

  --project NOME  il progetto (params-NOME.env dei progetti installati; _default è
                  l'installazione senza PROJECT). Senza, il solo progetto installato.
  -h, --help      questo aiuto; l'aiuto di devloop è `devloop <sottocomando> --help`
EOF
}

case ${1:-} in
    -h | --help) usage; exit 0 ;;
esac
# Come root: i file dei progetti e sudo verso l'utente di ciascun progetto.
if [ "$(id -u)" != 0 ]; then
    exec sudo -- "$0" "$@"
fi

project=''
while [ $# -gt 0 ]; do
    case $1 in
        --project)
            [ $# -ge 2 ] || die '--project vuole il nome di un progetto'
            project=$2
            shift 2
            ;;
        --project=*) project=${1#--project=}; shift ;;
        -h | --help) usage; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || { usage >&2; exit 2; }

# Di root e non scrivibile dal gruppo né dagli altri: chi potesse cambiare un file dei progetti
# sceglierebbe che cosa esegue root.
trusted() {
    local owner mode
    read -r owner mode < <(stat -c '%u %a' "$1") || return 1
    [ "$owner" = 0 ] && ! (( 8#$mode & 8#022 ))
}

if ! [ -d "$PROJECTS_DIR" ] || [ -L "$PROJECTS_DIR" ]; then
    die "nessun progetto installato: $PROJECTS_DIR non esiste (setup-devloop.sh)"
fi
trusted "$PROJECTS_DIR" || die "$PROJECTS_DIR deve essere di root e non scrivibile da altri"
projects=()
for file in "$PROJECTS_DIR"/params-*.env; do
    [ -f "$file" ] && ! [ -L "$file" ] || continue
    name=${file##*/params-}
    projects+=("${name%.env}")
done
list=${projects[*]:-nessuno}
list=${list// /, }

if [ -n "$project" ]; then
    [[ $project =~ ^(_default|[a-z0-9]([a-z0-9-]{0,14}[a-z0-9])?)$ ]] \
        || die "nome di progetto non valido: '$project'"
    found=0
    for name in "${projects[@]}"; do
        [ "$name" = "$project" ] && found=1
    done
    [ "$found" = 1 ] || die "il progetto $project non è installato (progetti: $list)"
elif [ ${#projects[@]} -eq 0 ]; then
    die "nessun progetto installato in $PROJECTS_DIR (setup-devloop.sh)"
elif [ ${#projects[@]} -gt 1 ]; then
    die "più progetti installati ($list): sceglierne uno con --project NOME"
else
    project=${projects[0]}
fi

file=$PROJECTS_DIR/params-$project.env
trusted "$file" || die "$file deve essere di root e non scrivibile da altri"
DEVLOOP_USER='' DEVLOOP_CLONE='' DEVLOOP_PATH='' LAUNCHER_CMD='' SERVICE_NAME='' COORDINATION_DIR=''
while IFS= read -r line || [ -n "$line" ]; do
    case $line in '' | '#'*) continue ;; esac
    key=${line%%=*}
    case $key in
        DEVLOOP_USER | DEVLOOP_CLONE | DEVLOOP_PATH | LAUNCHER_CMD | SERVICE_NAME | COORDINATION_DIR)
            printf -v "$key" '%s' "${line#*=}" ;;
        *) die "$file: riga non riconosciuta: $key (rieseguire setup-devloop.sh)" ;;
    esac
done <"$file"
# Le forme che ops/lib.sh ammette per questi parametri; mai root.
[[ $DEVLOOP_USER =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && [ "$DEVLOOP_USER" != root ] \
    || die "$file: DEVLOOP_USER non valido: '$DEVLOOP_USER'"
[[ $DEVLOOP_CLONE =~ ^/[A-Za-z0-9._/-]*$ ]] || die "$file: DEVLOOP_CLONE non valido: '$DEVLOOP_CLONE'"
[[ $DEVLOOP_PATH =~ ^[A-Za-z0-9._/:-]+$ ]] || die "$file: DEVLOOP_PATH non valido: '$DEVLOOP_PATH'"
[[ $LAUNCHER_CMD =~ ^/[A-Za-z0-9._/\ -]+$ ]] || die "$file: LAUNCHER_CMD non valido: '$LAUNCHER_CMD'"
read -r -a launcher <<<"$LAUNCHER_CMD"

# La pausa e la ripresa dell'operatore (#685), come root.
case $1 in
    pause | resume)
        [ $# -eq 1 ] || die "$1 non vuole argomenti"
        [ -n "$SERVICE_NAME" ] && [ -n "$COORDINATION_DIR" ] \
            || die "$file: mancano SERVICE_NAME e COORDINATION_DIR, che $1 usa: rieseguire setup-devloop.sh (ops/host/migrate.md, \"La pausa dell'operatore (#685)\")"
        [[ $SERVICE_NAME =~ ^[A-Za-z0-9_-]+(@[a-z0-9_-]+)?$ ]] \
            || die "$file: SERVICE_NAME non valido: '$SERVICE_NAME'"
        [[ $COORDINATION_DIR =~ ^/[A-Za-z0-9._/-]*$ ]] \
            || die "$file: COORDINATION_DIR non valido: '$COORDINATION_DIR'"
        rest=$COORDINATION_DIR/rest
        pause_file=$rest/pause
        utc() { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }
        if [ "$1" = resume ]; then
            # Prima la pausa, poi il servizio: devloop run non parte finché la pausa c'è.
            if [ -e "$pause_file" ] || [ -L "$pause_file" ]; then
                rm -f -- "$pause_file" || die "non tolgo la pausa $pause_file"
                printf 'devloop: pausa del progetto %s tolta\n' "$project"
            else
                printf 'devloop: il progetto %s non era in pausa\n' "$project"
            fi
            systemctl start "$SERVICE_NAME" \
                || die "systemctl start $SERVICE_NAME non riuscito: la pausa è tolta, il servizio no (journalctl -u $SERVICE_NAME)"
            printf 'devloop: %s avviato; i ruoli in pausa si svegliano\n' "$SERVICE_NAME"
            exit 0
        fi
        [ -d "$rest" ] && ! [ -L "$rest" ] \
            || die "manca $rest, la directory del riposo dei ruoli: setup-supervisor.sh e setup-coordinator.sh (ops/host/migrate.md, \"Il riposo dei ruoli (#684)\")"
        # Prima la pausa, poi il servizio: i ruoli non si svegliano sul servizio fermo, e un
        # loop che la vede non avvia altri tick.
        start='' why=''
        if [ -f "$pause_file" ] && ! [ -L "$pause_file" ] \
            && [ "$(stat -c %u -- "$pause_file")" = 0 ] && read -r start why <"$pause_file" \
            && [[ $start =~ ^[0-9]{1,12}$ ]] && [ "$why" = pausa ]; then
            printf 'devloop: il progetto %s è già in pausa dal %s\n' "$project" "$(utc "$start")"
        else
            start=$(date +%s)
            tmp=$(mktemp "$rest/.pause-XXXXXX") || die "non scrivo in $rest"
            if ! { printf '%s pausa\n' "$start" >"$tmp" && chmod 644 "$tmp" && mv -f -- "$tmp" "$pause_file"; }
            then
                rm -f -- "$tmp"
                die "non scrivo la pausa $pause_file"
            fi
            printf 'devloop: progetto %s in pausa dal %s\n' "$project" "$(utc "$start")"
        fi
        printf 'devloop: fermo %s: devloop finisce il tick e le azioni in corso, poi si ferma\n' \
            "$SERVICE_NAME"
        systemctl stop "$SERVICE_NAME" \
            || die "systemctl stop $SERVICE_NAME non riuscito: la pausa c'è, e devloop run non avvia altri tick (journalctl -u $SERVICE_NAME)"
        printf 'devloop: %s fermo e i ruoli in pausa; per riprendere: devloop --project %s resume\n' \
            "$SERVICE_NAME" "$project"
        exit 0
        ;;
esac

# Nel clone, come WorkingDirectory dell'unità: sudo tiene la directory corrente.
cd "$DEVLOOP_CLONE" || die "$DEVLOOP_CLONE non è accessibile"
exec sudo -u "$DEVLOOP_USER" -H -- /usr/bin/env PATH="$DEVLOOP_PATH" PYTHONUNBUFFERED=1 \
    "${launcher[@]}" "$@"
