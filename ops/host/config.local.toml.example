# Overlay locale di devloop: <state_dir>/config.local.toml (per default
# <clone>/.ssdlc/devloop/config.local.toml), dell'utente devloop.
# setup-devloop.sh lo copia da qui solo se non esiste; poi è dell'operatore.
#
# Contiene SOLO le chiavi che l'operatore sovrascrive: devloop lo applica sopra
# devloop/config.toml della copia fissata (una tabella si unisce chiave per chiave, ogni altro
# valore sostituisce quello della copia). Così com'è, tutto commentato, non cambia nulla.
# Una chiave che config.toml non può avere ferma devloop. Riferimento: docs/devloop/guide.md,
# "Local config as an overlay", e docs/devloop/reference.md per ogni chiave.
# Nessun segreto qui: le chiavi delle app stanno in key_dir.

# Il repository gestito e chi può avviare il lavoro (ADR 0006, R6): stanno solo qui, non in
# devloop/config.toml. Senza repo e trusted_users devloop non parte. repo è REPO di params.env.
# repo = "brushtyler/ssdlc"
# trusted_users = ["brushtyler"]

# Solo per un progetto che non contiene devloop (ADR 0006, R1): il clone della sorgente da cui
# devloop pin prende il codice (SOURCE_CLONE) e lo state_dir dell'host, lo stesso che l'avviatore
# riceve con --state-dir (STATE_DIR di params.env).
# source = "/home/devloop/devloop-source"
# state_dir = "/var/lib/devloop/progetto"

# La directory comune dei lock per repository dell'host (ADR 0006, R8; REPO_LOCK_DIR di
# params.env, preparata da setup-devloop.sh): tick e run prendono il lock del repository e si
# fermano se un altro dispatcher, con un altro state_dir, lo tiene già. check-host.sh la richiede.
# repo_lock_dir = "/run/devloop/repos"

# Limiti (una modifica vale dal tick successivo, senza riavvio).
# max_open_prs = 2
# max_parked_prs = 3
# max_review_rounds = 3

# Chi fa il controllo di prontezza prima dell'implementazione.
# preflight = "codex"

# Modalità di merge: "off" (merge dell'operatore), "strict" o "auto". Decisione dell'operatore.
# [merge]
# mode = "off"

# Nuovo pin di origin/main dopo un merge di devloop che tocca devloop/ o core/.
# [pin]
# auto = false

# Issue su cui commentare l'allarme di tre tick falliti di fila (senza: solo una riga nel log).
# [run]
# alert_issue = 123

# Issue del riepilogo giornaliero (senza: nessun riepilogo).
# [report]
# issue = 124

# L'utente con cui girano le CLI degli agent e i test (#415): lo prepara setup-agent-user.sh.
# Senza, gli agent girano come l'utente devloop e possono leggere le chiavi delle app;
# check-host.sh lo segnala come errore.
# [agent_user]
# name = "devloop-agent"

# Il supervisore che decide le escalation non critiche (identità della sua app).
# [roles]
# supervisor = "claude"
# Oppure, con l'app di ruolo del supervisore (ADR 0005, P5-4; decisione dell'operatore, con la
# coda vuota): l'attore claude-supervisor, che firma con [apps.supervisor]. Al posto delle due
# righe sopra, non insieme (docs/devloop/reference.md, "The supervisor app"):
#     [roles.supervisor]
#     name = "claude-supervisor"
#     kind = "claude"
#     provider = "anthropic"
#     model = "claude-opus-5-5"

# L'insieme di GitHub App del progetto (ADR 0006, R6 e D3): uno per repository, mai condiviso,
# installato solo su REPO, con la sua key_dir (DEVLOOP_KEY_DIR di params.env). Una tabella per
# app (dispatcher, claude, codex, agy, merger, supervisor, implementer) con app_id e slug
# (<APP_PREFIX><ruolo>, ops/github/create-apps.sh). merger solo se devloop fa i merge ([merge]
# mode "strict" o "auto"). Senza [apps], ogni attore usa il login gh dell'utente devloop.
# Verifica: devloop-pinned apps (docs/devloop/reference.md, "GitHub identities").
# [apps]
# key_dir = "~/.ghapps"
# [apps.dispatcher]
# app_id = 5747835
# slug = "brushtyler-devloop-dispatcher"
