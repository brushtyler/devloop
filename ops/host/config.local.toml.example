# Overlay locale di devloop: <state_dir>/config.local.toml (per default
# <clone>/.devloop/config.local.toml), dell'utente devloop.
# setup-devloop.sh lo copia da qui solo se non esiste; poi è dell'operatore.
#
# Contiene SOLO le chiavi che l'operatore sovrascrive: devloop lo applica sopra
# devloop/config.toml della copia fissata (una tabella si unisce chiave per chiave, ogni altro
# valore sostituisce quello della copia). Così com'è, tutto commentato, non cambia nulla.
# Una chiave che config.toml non può avere ferma devloop. Riferimento: docs/devloop/guide.md,
# "Local config as an overlay", e docs/devloop/reference.md per ogni chiave.
# Nessun segreto qui: le chiavi delle app stanno in key_dir.

# Il repository gestito e chi può avviare il lavoro (ADR 0006, R6): stanno solo qui, non in
# devloop/config.toml. Senza repo e trusted_users devloop non parte. repo è REPO di params.env.
# repo = "brushtyler/devloop"
# trusted_users = ["brushtyler"]
# I login GitHub, senza @, menzionati nei commenti che chiedono una decisione all'operatore (#593):
# la menzione arriva sul telefono con GitHub Mobile. Indipendenti da trusted_users; senza, nessuno.
# operator_mentions = ["brushtyler"]
# Solo dopo una rinomina del repository su GitHub (#540, ADR 0007): i nomi di prima, perché i
# link ai commenti, i record del journal e i marker scritti con quei nomi restino validi.
# ops/host/migrate.md, "Rinomina del repository in devloop".
# repo_aliases = ["brushtyler/nome-di-prima"]

# Solo per un progetto che non contiene devloop (ADR 0006, R1): il clone della sorgente da cui
# devloop pin prende il codice (SOURCE_CLONE) e lo state_dir dell'host, lo stesso che l'avviatore
# riceve con --state-dir (STATE_DIR di params.env).
# source = "/home/devloop/devloop-source"
# state_dir = "/var/lib/devloop/progetto"

# La directory comune dei lock per repository dell'host (ADR 0006, R8; REPO_LOCK_DIR di
# params.env, preparata da setup-devloop.sh): tick e run prendono il lock del repository e si
# fermano se un altro dispatcher, con un altro state_dir, lo tiene già. check-host.sh la richiede.
# repo_lock_dir = "/run/devloop/repos"

# Limiti (una modifica vale dal tick successivo, senza riavvio).
# max_open_prs = 2
# max_parked_prs = 3
# max_review_rounds = 3

# Chi fa il controllo di prontezza prima dell'implementazione: una chiave di reviewer, in sola
# lettura come una review (#499), mai una chiave di implementer.
# preflight = "codex-reviewer"

# Modalità di merge: "off" (merge dell'operatore), "strict" o "auto". Decisione dell'operatore.
# [merge]
# mode = "off"

# Nuovo pin di origin/main dopo un merge di devloop che tocca devloop/ o core/.
# [pin]
# auto = false

# Issue su cui commentare l'allarme di tre tick falliti di fila (senza: solo una riga nel log).
# [run]
# alert_issue = 123

# Issue del riepilogo giornaliero (senza: nessun riepilogo).
# [report]
# issue = 124

# Gli avvisi all'operatore fuori da GitHub (#593): `devloop notify`, Telegram, solo in uscita.
# token_file è il file del token del bot nella key_dir dell'utente devloop, suo, mode 600: mai il
# token qui. Lo stesso avviso non si ripete entro interval secondi. Senza: solo righe nel log.
# docs/devloop/guide.md, "Notices to the operator"; ops/host/migrate.md, "Avvisi all'operatore".
# [notify]
# backend = "telegram"
# chat_id = 123456789
# token_file = "/home/devloop/.ghapps/telegram-bot.token"
# interval = 900

# Issue della direzione dell'operatore (#604): vale l'ultimo commento di un utente di
# trusted_users che inizia con la riga "## Direzione" (senza: le priorità restano alle
# etichette dell'operatore). La leggono `devloop direction` e `devloop status`.
# [direction]
# issue = 125

# L'utente con cui girano le CLI degli agent e i test (#415): lo prepara setup-agent-user.sh.
# Senza, gli agent girano come l'utente devloop e possono leggere le chiavi delle app;
# check-host.sh lo segnala come errore.
# [agent_user]
# name = "devloop-agent"
# Voci della lista del codice che le directory delle CLI non possono contenere su questo host
# (#517): l'overlay può solo toglierne, mai aggiungerne.
# cli_denied = [".codex/memories_1.sqlite*"]

# Le revisioni consultive delle PR che arrivano all'operatore (#369), con il terzo reviewer.
# [review_policy]
# advisory_reviewer = "claude-reviewer"
# Le regole dei reviewer sul fornitore (ADR 0005, P5-5): claude-reviewer sostituisce agy quando
# agy non è disponibile, accanto a un reviewer di un altro fornitore.
# provider_quorum = true

# Il supervisore che decide le escalation non critiche: l'attore claude-supervisor, che firma
# con [apps.supervisor] (ADR 0005, P5-4; docs/devloop/reference.md, "The supervisor app"). Con
# le chiavi per ruolo (#499) roles.supervisor non può essere una chiave di [agents].
# [roles.supervisor]
# name = "claude-supervisor"
# kind = "claude"
# provider = "anthropic"
# model = "claude-opus-5-5"

# L'insieme di GitHub App del progetto (ADR 0006, R6 e D3): per default uno per repository,
# installato solo su REPO; a scelta, uno condiviso fra repository dello stesso proprietario
# sullo stesso host, con i limiti di ops/README.md ("Insieme di app per repository o condiviso").
# Sempre con la key_dir del progetto (DEVLOOP_KEY_DIR di params.env). Una tabella per
# app (dispatcher, claude, codex, agy, merger, supervisor, implementer, coordinator) con app_id
# e slug (<APP_PREFIX><ruolo>, ops/github/create-apps.sh). merger solo se devloop fa i merge
# ([merge] mode "strict" o "auto"), coordinator solo se c'è il coordinatore. Gli agent di devloop/config.toml dichiarano le app implementer,
# claude, codex e agy (#499): senza le loro tabelle devloop non parte. Un attore senza app (il
# dispatcher, il merger) usa il login gh dell'utente devloop.
# Verifica: devloop-pinned apps (docs/devloop/reference.md, "GitHub identities").
# [apps]
# key_dir = "~/.ghapps"
# [apps.dispatcher]
# app_id = 5747835
# slug = "brushtyler-devloop-dispatcher"
# [apps.claude]
# app_id = 5735240
# slug = "brushtyler-devloop-claude-agent"
# [apps.codex]
# app_id = 5735296
# slug = "brushtyler-devloop-codex-agent"
# [apps.agy]
# app_id = 5735349
# slug = "brushtyler-devloop-agy-agent"
# [apps.supervisor]
# app_id = 5824243
# slug = "brushtyler-devloop-supervisor"
# [apps.implementer]
# app_id = 5824194
# slug = "brushtyler-devloop-implementer"
# Il coordinatore (#528, #549): la sua app conta solo con [roles.coordinator]. devloop non ne
# legge mai la chiave, che sta nella key_dir dell'utente coordinator (COORDINATOR_KEY_DIR di
# params.env, preparata da setup-coordinator.sh); il coordinatore ne conia i token con
# scripts/coordinator-token.py --state-dir <state_dir>, che legge repo e questa tabella, con
# DEVLOOP_APP_KEY_DIR sulla propria key_dir: key_dir qui sopra è quella di devloop.
# [apps.coordinator]
# app_id = 1234567  # l'id che stampa lo scambio del code (ops/README.md, passo 2)
# slug = "brushtyler-devloop-coordinator"
