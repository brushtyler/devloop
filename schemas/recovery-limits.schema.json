{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "invocations",
    "wall_seconds",
    "role_invocations",
    "phase_invocations",
    "transport_retries",
    "design_diagnoses",
    "metered_usd",
    "cli_estimate_usd",
    "development_attempts",
    "design_rounds",
    "invocation_timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "invocations": {
      "type": "integer",
      "minimum": 1
    },
    "wall_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "role_invocations": {
      "$ref": "#/$defs/caps"
    },
    "phase_invocations": {
      "$ref": "#/$defs/caps"
    },
    "transport_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "design_diagnoses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "metered_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cli_estimate_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "development_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "design_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "invocation_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "historical_unknown_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocations",
        "metered_usd",
        "cli_estimate_usd"
      ],
      "properties": {
        "invocations": {
          "type": "integer",
          "minimum": 1
        },
        "metered_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cli_estimate_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "combined_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "unknown_usage_reserve_model": {
      "enum": [
        "exclusive_cost_kind_v1"
      ],
      "description": "Opt-in: an unknown invocation belongs to one cost kind. Each kind cap reserves its full allowance; the combined cap reserves the maximum once, not their sum. Absent retains additive legacy semantics."
    },
    "live_unknown_usage": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "claude",
          "codex",
          "agy",
          "openrouter"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/live_usage_model"
      },
      "description": "Explicit per-engine rule for live invocations that report no dollar cost. Absent is not zero: an engine that never reports cost is refused before launch, and a returned live row with null usage blocks the next dispatch."
    },
    "task_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capability",
        "tasks"
      ],
      "description": "Per-task caps on cumulative consumption (#163). The run caps stay the defaults and the overall limit; a task without an entry is bound by them only. The sum of the task caps of a dimension never exceeds the run cap. Dollar task caps are decimals with at most six places. Calls no task owns stay on the shared run account.",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "capability": {
          "const": "task-budget-v1"
        },
        "tasks": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 200,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/task_caps"
          }
        },
        "prior_invocations": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": "Invocations recorded before an allocate_task_budget transition: listed, never charged to a task."
        }
      }
    },
    "feedback_delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capability",
        "allowed_files",
        "max_amendments",
        "max_amendments_per_task",
        "max_added_files",
        "require_strong_independence"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "capability": {
          "const": "feedback-scope-delegation-v1"
        },
        "allowed_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_./-]+$"
          }
        },
        "require_strong_independence": {
          "const": true
        },
        "owner_revalidation": {
          "const": true,
          "description": "Explicit opt-in for independently reviewed completed-owner amendments with fresh native owner checks; absence preserves operator-only ownership recovery."
        },
        "max_amendments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_amendments_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_added_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "feedback_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "roles"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "enabled": {
          "const": true
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planner",
            "reviewer"
          ],
          "properties": {
            "planner": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "model",
                "effort"
              ],
              "properties": {
                "engine": {
                  "enum": [
                    "claude",
                    "codex",
                    "agy"
                  ]
                },
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,119}$"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh"
                  ]
                }
              }
            },
            "reviewer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "model",
                "effort"
              ],
              "properties": {
                "engine": {
                  "enum": [
                    "claude",
                    "codex",
                    "agy"
                  ]
                },
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,119}$"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh"
                  ]
                }
              }
            },
            "po": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "model",
                "effort"
              ],
              "properties": {
                "engine": {
                  "enum": [
                    "claude",
                    "codex",
                    "agy"
                  ]
                },
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,119}$"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh"
                  ]
                }
              }
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "issue"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "issue": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "live_usage_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600,
      "pattern": "\\S"
    },
    "live_usage_model": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "metered_usd",
            "cli_estimate_usd",
            "reason"
          ],
          "properties": {
            "model": {
              "const": "reserve_per_invocation"
            },
            "metered_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cli_estimate_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reason": {
              "$ref": "#/$defs/live_usage_reason"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "reason"
          ],
          "properties": {
            "model": {
              "const": "unmetered_quota"
            },
            "reason": {
              "$ref": "#/$defs/live_usage_reason"
            }
          }
        }
      ]
    },
    "task_caps": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "invocations": {
          "type": "integer",
          "minimum": 0
        },
        "metered_usd": {
          "type": "number",
          "minimum": 0
        },
        "cli_estimate_usd": {
          "type": "number",
          "minimum": 0
        },
        "role_invocations": {
          "$ref": "#/$defs/task_family_caps"
        },
        "phase_invocations": {
          "$ref": "#/$defs/task_family_caps"
        }
      }
    },
    "task_family_caps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "caps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
