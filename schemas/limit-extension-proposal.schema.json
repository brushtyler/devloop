{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Versioned proposal of a manual limit extension (operator-limit-extension-v1). It grants nothing: only an exact operator authorization bound to its hash, then an atomic activation, apply it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "operation",
    "run",
    "parent",
    "consumption",
    "changes",
    "new_profile",
    "cause",
    "evidence",
    "actor",
    "applicability",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "operator-limit-extension-v1"
    },
    "operation": {
      "enum": [
        "extend_global_limit",
        "extend_deadline",
        "reverify_after_timeout"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket",
        "source",
        "generation",
        "task_id"
      ],
      "properties": {
        "ticket": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "source": {
          "enum": [
            "native",
            "reconciled"
          ]
        },
        "generation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          ]
        },
        "task_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          ]
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_sha256",
        "profile_sha256",
        "counters_sha256",
        "limits_journal",
        "scheduler_journal",
        "selector_sha256",
        "state_status",
        "inputs",
        "feedback"
      ],
      "properties": {
        "inputs": {
          "type": "object",
          "description": "SHA-256 of the run inputs the proposal was reviewed against; null when the file is absent.",
          "additionalProperties": false,
          "required": [
            "state.json",
            "02-design/plan.json",
            "00-recon/quality-contract.json",
            "01-po/requirements.md",
            "02-design/adr.md",
            "02-design/threat-model.md"
          ],
          "properties": {
            "state.json": {
              "$ref": "#/$defs/optional_sha256"
            },
            "02-design/plan.json": {
              "$ref": "#/$defs/optional_sha256"
            },
            "00-recon/quality-contract.json": {
              "$ref": "#/$defs/optional_sha256"
            },
            "01-po/requirements.md": {
              "$ref": "#/$defs/optional_sha256"
            },
            "02-design/adr.md": {
              "$ref": "#/$defs/optional_sha256"
            },
            "02-design/threat-model.md": {
              "$ref": "#/$defs/optional_sha256"
            }
          }
        },
        "feedback": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "description": "The feedback ledger of the run: its authority, journal head and the unresolved requests the extension does not convert.",
              "additionalProperties": false,
              "required": [
                "authority_sha256",
                "journal",
                "unresolved_requests"
              ],
              "properties": {
                "authority_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "journal": {
                  "$ref": "#/$defs/head"
                },
                "unresolved_requests": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "request_id",
                      "disposition"
                    ],
                    "properties": {
                      "request_id": {
                        "type": "string"
                      },
                      "disposition": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "counters_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "limits_journal": {
          "$ref": "#/$defs/head"
        },
        "scheduler_journal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/head"
            }
          ]
        },
        "selector_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "state_status": {
          "type": "string"
        }
      }
    },
    "consumption": {
      "type": "object",
      "description": "Counters, observed costs, unknown usage, reserves and attempts at proposal time. Unknown values stay null."
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "old",
          "new"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "old": {
            "type": "number"
          },
          "new": {
            "type": "number"
          }
        }
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "old_deadline_at",
        "new_deadline_at",
        "old_wall_seconds",
        "new_wall_seconds",
        "expired_at_proposal"
      ],
      "properties": {
        "started_at": {
          "type": "number"
        },
        "old_deadline_at": {
          "type": "number"
        },
        "new_deadline_at": {
          "type": "number"
        },
        "old_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "new_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "expired_at_proposal": {
          "type": "boolean"
        }
      }
    },
    "reverification": {
      "type": "object",
      "description": "The captured verifier timeout a reverify_after_timeout proposal is bound to: the same candidate, each timed-out check with its applied timeout and measured duration, and the verifications the attempt already used.",
      "additionalProperties": false,
      "required": [
        "task_id",
        "attempt",
        "failure_sha256",
        "capture_sha256",
        "candidate_tree",
        "verifications_used",
        "verification_limit",
        "invocation_timeout_seconds",
        "timed_out_checks"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "failure_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capture_sha256": {
          "type": "string",
          "minLength": 1
        },
        "candidate_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "verifications_used": {
          "type": "integer",
          "minimum": 0
        },
        "verification_limit": {
          "const": 3
        },
        "invocation_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "timed_out_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "exit_code",
              "timeout_sec",
              "elapsed_seconds",
              "log_ref",
              "log_sha256"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "const": 124
              },
              "timeout_sec": {
                "type": "integer",
                "minimum": 1
              },
              "elapsed_seconds": {
                "type": "number",
                "minimum": 0
              },
              "log_ref": {
                "type": "string",
                "minLength": 1
              },
              "log_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "new_profile": {
      "type": "object",
      "description": "The exact resulting recovery-limits profile: the parent profile with only the named dimensions changed."
    },
    "cause": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "\\S"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_statuses",
        "resolved_invocations",
        "quiescent_feedback_ledger",
        "quiescent_writers",
        "operator_authorization"
      ],
      "properties": {
        "source_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resolved_invocations": {
          "const": true
        },
        "quiescent_feedback_ledger": {
          "const": true
        },
        "quiescent_writers": {
          "const": true
        },
        "operator_authorization": {
          "const": "exact-proposal-sha256-with-expiry"
        }
      }
    },
    "created_at": {
      "type": "number"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "extend_global_limit"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "deadline"
              ]
            },
            {
              "required": [
                "reverification"
              ]
            }
          ]
        },
        "properties": {
          "changes": {
            "items": {
              "properties": {
                "dimension": {
                  "pattern": "^(metered_usd|cli_estimate_usd|invocations|development_attempts|role_invocations\\.[A-Za-z0-9][A-Za-z0-9_-]{0,63}|phase_invocations\\.[A-Za-z0-9][A-Za-z0-9_-]{0,63})$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "extend_deadline"
          }
        }
      },
      "then": {
        "required": [
          "deadline"
        ],
        "not": {
          "required": [
            "reverification"
          ]
        },
        "properties": {
          "changes": {
            "maxItems": 1,
            "items": {
              "properties": {
                "dimension": {
                  "const": "deadline_at"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "reverify_after_timeout"
          }
        }
      },
      "then": {
        "required": [
          "reverification"
        ],
        "not": {
          "required": [
            "deadline"
          ]
        },
        "properties": {
          "run": {
            "properties": {
              "task_id": {
                "type": "string"
              }
            }
          },
          "changes": {
            "items": {
              "properties": {
                "dimension": {
                  "pattern": "^check_timeout\\..+$"
                },
                "old": {
                  "type": "integer"
                },
                "new": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "optional_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "sha256"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    }
  }
}
